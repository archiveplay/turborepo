{
  "$schema": "https://turbo.build/schema.json",
  "ui": "tui",

  "globalEnv": ["PORT"],

  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },

    "dev": {
      "cache": false,
      "persistent": true
    },

    "test": {
      "dependsOn": ["^build"]
    },

    "lint": {
      "dependsOn": ["^lint"],
      "outputs": []
    },

    "check": {}
  }
}
